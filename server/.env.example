NODE_ENV=development
PORT=5000

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/collagerag

# JWT Secret
JWT_SECRET=your_jwt_secret_phrase_here
JWT_EXPIRES_IN=7d

# Frontend client URL
CLIENT_URL=http://localhost:3000

# Gemini API Key (Required for Phase 3+)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Pinecone Settings (Required for Phase 3+)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=collagerag-index
PINECONE_NAMESPACE=college-docs

# Storage Settings
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# RAG Configuration
TOP_K=5
MIN_RELEVANCE_SCORE=0.65
CHUNK_SIZE=900
CHUNK_OVERLAP=120
